      "allowedChangeScopes": [
        "catalog-metadata",
        "contract",
        "implementation",
        "tests"
      ],
      "approvalPolicy": "owner-review",
      "verification": {
        "kind": "command",
        "value": "mvn -q test"
      }
    },
    "finance-harness-integration": {
      "owner": "finance-harness-maintainers",
      "repository": "https://github.com/bitlhk/finance-agent-harness",
      "changeMode": "proposal-only",
      "allowedChangeScopes": [
        "catalog-metadata",
        "integration",
        "tests"
      ],
      "approvalPolicy": "owner-review",
      "verification": {
        "kind": "command",
        "value": "mvn -q -pl integrations/openjiuwen-java -am test"
      }
    },
    "finance-skill-eval": {
      "owner": "finance-skill-eval-maintainers",
      "repository": "https://github.com/bitlhk/finance-skill-eval",
      "changeMode": "proposal-only",
      "allowedChangeScopes": [
        "evaluation-pack",
        "datasets",
        "tests"
      ],
      "approvalPolicy": "owner-review",
      "verification": {
        "kind": "document",
