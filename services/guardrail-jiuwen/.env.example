# guardrail-jiuwen 环境配置
# 复制此文件为 .env 并填入实际值

# OpenAI 兼容 API 配置（用于 LLM 安全检测）
OPENAI_API_KEY=your-api-key-here
OPENAI_BASE_URL=https://api.siliconflow.cn/v1
OPENAI_MODEL=Qwen/Qwen3.5-9B

# Embedding 模型配置（内容过滤用）
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5

# PII 检测总开关（engine 级别）：设为 false 则完全不初始化 PII 服务
# JSON policy/pii_config.json 中的 enabled 字段是策略级别开关，两者都为 true 时 PII 才生效
GUARDRAIL_ENABLE_PII=true

# FastAPI 服务鉴权 Key（留空则不启用鉴权，生产环境建议设置）
GUARDRAIL_API_KEY=
