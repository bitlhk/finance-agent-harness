# Included inside nginx http {}. Only this HTTPS virtual host exposes the Studio.
limit_req_zone $binary_remote_addr zone=finance_studio:10m rate=10r/s;

server {
    listen 80;
    server_name @@DOMAIN@@;
    return 301 https://@@DOMAIN@@$request_uri;
}

server {
    listen 443 ssl;
    server_name @@DOMAIN@@;
    ssl_certificate /etc/finance-studio/tls/fullchain.pem;
    ssl_certificate_key /etc/finance-studio/tls/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;
    if ($http_host != "@@DOMAIN@@") { return 421; }
    auth_basic "Finance Studio";
    auth_basic_user_file /etc/finance-studio/users.htpasswd;
    client_max_body_size 16k;
    client_body_timeout 15s;
    keepalive_timeout 30s;
    limit_req zone=finance_studio burst=30 nodelay;
    limit_req_status 429;
    # Never log credentials, query strings, financial payloads or local paths.
    access_log off;
    error_log /var/log/nginx/finance-studio-error.log warn;
    add_header Strict-Transport-Security "max-age=86400" always;
    add_header X-Content-Type-Options nosniff always;

    location / {
        limit_except GET POST { deny all; }
        proxy_pass http://127.0.0.1:18148;
        proxy_http_version 1.1;
        proxy_set_header Host @@DOMAIN@@;
        proxy_set_header X-Finance-User $remote_user;
        include /etc/finance-studio/proxy-header.conf;
        proxy_set_header Authorization "";
        proxy_set_header Connection "";
        proxy_set_header Forwarded "";
        proxy_set_header X-Forwarded-Host "";
        proxy_set_header X-Forwarded-For "";
        proxy_set_header X-Forwarded-Proto "";
        proxy_connect_timeout 5s;
        proxy_read_timeout 150s;
        proxy_send_timeout 30s;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_max_temp_file_size 0;
        proxy_next_upstream off;
    }
}
