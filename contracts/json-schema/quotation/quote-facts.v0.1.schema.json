{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bitlhk.github.io/finance-agent-harness/schema/quote-facts.v0.1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "subjectRef",
    "productRef",
    "currency",
    "state",
    "quote",
    "gaps",
    "source"
  ],
  "properties": {
    "schemaVersion": {
      "const": "quote-facts.v0.1"
    },
    "subjectRef": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,128}$"
    },
    "productRef": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,128}$"
    },
    "currency": {
      "const": "CNY"
    },
    "state": {
      "enum": [
        "AVAILABLE",
        "NOT_APPLICABLE",
        "MISSING",
        "UNAVAILABLE",
        "EXPIRED",
        "CONFLICT"
      ]
    },
    "quote": {
      "oneOf": [
        {
          "$ref": "#/$defs/quote"
        },
        {
          "type": "null"
        }
      ]
    },
    "gaps": {
      "$ref": "#/$defs/gaps"
    },
    "source": {
      "$ref": "#/$defs/source"
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,128}$"
    },
    "money": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "currency"
      ],
      "properties": {
        "value": {
          "type": "string",
          "pattern": "^(?:0|[1-9][0-9]{0,15})[.][0-9]{2}$"
        },
        "currency": {
          "const": "CNY"
        }
      }
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "quote": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "quoteId",
        "listPrice",
        "referencePrice",
        "priceFactorBps",
        "priceBasis",
        "validFrom",
        "validUntil",
        "eligibility",
        "conditions",
        "claimCodes",
        "effect"
      ],
      "properties": {
        "quoteId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,128}$"
        },
        "listPrice": {
          "$ref": "#/$defs/money"
        },
        "referencePrice": {
          "$ref": "#/$defs/money"
        },
        "priceFactorBps": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "priceBasis": {
          "const": "PER_UNIT"
        },
        "validFrom": {
          "$ref": "#/$defs/timestamp"
        },
        "validUntil": {
          "$ref": "#/$defs/timestamp"
        },
        "eligibility": {
          "const": "ELIGIBLE"
        },
        "conditions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "state"
            ],
            "properties": {
              "code": {
                "const": "DEMO_MEMBER_ELIGIBLE"
              },
              "state": {
                "const": "SATISFIED"
              }
            }
          }
        },
        "claimCodes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "contains": {
            "const": "REFERENCE_UNIT_PRICE"
          },
          "items": {
            "enum": [
              "REFERENCE_UNIT_PRICE",
              "CONDITIONAL_PRICE"
            ]
          }
        },
        "effect": {
          "const": "INFORMATION_ONLY"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceKind",
        "sourceId",
        "sourceVersion",
        "recordRef",
        "observedAt",
        "snapshotSha256"
      ],
      "properties": {
        "sourceKind": {
          "const": "CONTROLLED_FIXTURE"
        },
        "sourceId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,128}$"
        },
        "sourceVersion": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,128}$"
        },
        "recordRef": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,128}$"
        },
        "observedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "snapshotSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "gaps": {
      "type": "array",
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "enum": [
          "NOT_APPLICABLE",
          "MISSING_ELIGIBILITY",
          "MISSING_QUOTE",
          "SOURCE_UNAVAILABLE",
          "NOT_YET_VALID",
          "QUOTE_EXPIRED",
          "FACT_CONFLICT"
        ]
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "const": "AVAILABLE"
          }
        }
      },
      "then": {
        "properties": {
          "quote": {
            "$ref": "#/$defs/quote"
          },
          "gaps": {
            "maxItems": 0
          }
        }
      },
      "else": {
        "properties": {
          "quote": {
            "type": "null"
          },
          "gaps": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
