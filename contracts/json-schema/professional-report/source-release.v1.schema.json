{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:finance:report:source-release:v1",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "finance-professional-report-release.v1"
    },
    "sourceCommit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "assets": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "properties": {
          "assetId": {
            "enum": [
              "wealth-kyc",
              "market-risk-report"
            ]
          },
          "sourceRepository": {
            "const": "https://gitcode.com/openJiuwen/agent-store"
          },
          "sourceCommit": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}$"
          },
          "files": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "maxLength": 1024
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "bytes": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "path",
                "sha256",
                "bytes"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "assetId",
          "sourceRepository",
          "sourceCommit",
          "files"
        ],
        "additionalProperties": false
      }
    },
    "adapterFiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "maxLength": 1024
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "path",
          "sha256",
          "bytes"
        ],
        "additionalProperties": false
      }
    },
    "lockDigests": {
      "type": "object",
      "properties": {
        "wealth-kyc": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "market-risk-report": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      },
      "required": [
        "wealth-kyc",
        "market-risk-report"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "sourceCommit",
    "assets",
    "adapterFiles",
    "lockDigests"
  ],
  "additionalProperties": false
}
