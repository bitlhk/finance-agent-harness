{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:finance:report:artifact:v1",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,128}$"
    },
    "runId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,128}$"
    },
    "sourceResultId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,128}$"
    },
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-][A-Za-z0-9_.-]{0,127}$"
    },
    "mediaType": {
      "enum": [
        "text/markdown",
        "text/csv",
        "application/json",
        "image/png",
        "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
      ]
    },
    "bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16777216
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  },
  "required": [
    "id",
    "runId",
    "sourceResultId",
    "name",
    "mediaType",
    "bytes",
    "sha256"
  ],
  "additionalProperties": false
}
