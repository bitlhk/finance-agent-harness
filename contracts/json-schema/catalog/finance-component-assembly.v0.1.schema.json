{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bitlhk.github.io/finance-agent-harness/schema/finance-component-assembly.v0.1.schema.json",
  "title": "Candidate component-owned assembly declarations",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "owner"],
  "properties": {
    "schemaVersion": {}, "kind": {}, "owner": {}, "requiredFeatures": {},
    "defaultDomainPacks": {}, "artifactRef": {}, "connectionKind": {}, "supports": {}
  },
  "oneOf": [{"$ref": "#/$defs/pack"}, {"$ref": "#/$defs/provider"}],
  "$defs": {
    "identity": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,127}$"},
        "version": {"type": "string", "minLength": 1, "maxLength": 64}
      }
    },
    "strings": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128}},
    "pack": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "kind", "owner", "requiredFeatures", "defaultDomainPacks"],
      "properties": {
        "schemaVersion": {"const": "finance-component-assembly.v0.1"},
        "kind": {"const": "capability-pack"},
        "owner": {"$ref": "#/$defs/identity"},
        "requiredFeatures": {"$ref": "#/$defs/strings", "minItems": 1},
        "defaultDomainPacks": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/identity"}}
      }
    },
    "provider": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "kind", "owner", "artifactRef", "connectionKind", "supports"],
      "properties": {
        "schemaVersion": {"const": "finance-component-assembly.v0.1"},
        "kind": {"const": "provider"},
        "owner": {"$ref": "#/$defs/identity"},
        "artifactRef": {"type": "string", "pattern": "^maven://[^: /]+:[^: /]+:[^ /]+$", "maxLength": 512},
        "connectionKind": {"type": "string", "minLength": 1, "maxLength": 128},
        "supports": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["pack", "capabilityIds", "operation"],
            "properties": {
              "pack": {"$ref": "#/$defs/identity"},
              "capabilityIds": {"$ref": "#/$defs/strings", "minItems": 1},
              "operation": {"enum": ["QUERY", "TASK"]}
            }
          }
        }
      }
    }
  }
}
