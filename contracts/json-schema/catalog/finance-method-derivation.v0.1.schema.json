{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bitlhk.github.io/finance-agent-harness/schema/finance-method-derivation.v0.1.schema.json",
  "title": "Candidate private method derivation, not an authorization grant",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "componentId", "componentVersion", "directoryRevision", "capabilityIds", "basePackages", "copiedFrom", "replacement"],
  "properties": {
    "schemaVersion": {"const": "finance-method-derivation.v0.1"},
    "componentId": {"type": "string", "minLength": 1},
    "componentVersion": {"type": "string", "minLength": 1},
    "directoryRevision": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "capabilityIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "basePackages": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/reference"}},
    "copiedFrom": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/reference"}},
    "replacement": {"const": "REPLACE_SCOPED_METHOD_NOT_CAPABILITY"}
  },
  "$defs": {
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "version", "source", "digest"],
      "properties": {
        "kind": {"enum": ["capability-pack", "domain-pack", "host-method"]},
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "source": {"type": "string", "minLength": 1},
        "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
      }
    }
  }
}
