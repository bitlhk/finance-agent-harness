{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bitlhk.github.io/finance-agent-harness/schema/finance-business-component-package.v0.1.schema.json",
  "title": "Finance Business Component Package V0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "package", "skill", "bindings", "requirements", "cases", "validation", "files"],
  "properties": {
    "schemaVersion": {"const": "finance-business-component-package.v0.1"},
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "displayName", "maintainer", "visibility"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,127}$"},
        "version": {"type": "string", "pattern": "^[0-9]{1,4}\\.[0-9]{1,4}\\.[0-9]{1,4}$"},
        "displayName": {"type": "string", "minLength": 1, "maxLength": 160},
        "maintainer": {"type": "string", "minLength": 1, "maxLength": 160},
        "visibility": {"enum": ["PRIVATE", "TEAM", "ORGANIZATION"]}
      }
    },
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entry", "sourceKind"],
      "properties": {
        "entry": {"const": "skill/SKILL.md"},
        "sourceKind": {"enum": ["AUTHORED", "IMPORTED", "BUSINESS_DERIVED"]},
        "basePackageRefs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/packageRef"}
        }
      }
    },
    "bindings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {"$ref": "#/$defs/binding"}
    },
    "requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtimeFamilies", "runtimeLanguages", "execution", "observation", "requiredScopes"],
      "properties": {
        "runtimeFamilies": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 64}},
        "runtimeLanguages": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["java", "python", "typescript"]}},
        "execution": {"type": "array", "uniqueItems": true, "items": {"enum": ["QUERY", "TASK", "CONFIRMATION", "RECOVERY", "UNKNOWN_VERIFICATION"]}},
        "observation": {"type": "array", "uniqueItems": true, "items": {"enum": ["AUTHORIZATION", "MODEL_CALL", "TOOL_CALL", "PROVIDER_ATTEMPT", "BUSINESS_RESULT", "INSTALLATION_LOCK"]}},
        "requiredScopes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128}}
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,79}$"},
          "path": {"type": "string", "pattern": "^cases/[A-Za-z0-9._/-]+\\.json$"}
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "summaryPath", "professionalQuality"],
      "properties": {
        "status": {"enum": ["PASS", "FAIL", "NOT_RUN"]},
        "summaryPath": {"const": "validation-summary.json"},
        "professionalQuality": {"enum": ["ACCEPTED", "REQUIRES_HUMAN_REVIEW", "NOT_EVALUATED"]}
      }
    },
    "files": {
      "type": "array",
      "minItems": 3,
      "maxItems": 128,
      "items": {"$ref": "#/$defs/file"}
    }
  },
  "$defs": {
    "packageRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 128},
        "version": {"type": "string", "minLength": 1, "maxLength": 64}
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capabilityId", "capabilityPack", "toolName", "operation", "protocol", "inputSchemaRef", "outputSchemaRef", "confirmation"],
      "properties": {
        "capabilityId": {"type": "string", "minLength": 3, "maxLength": 128},
        "capabilityPack": {"$ref": "#/$defs/packageRef"},
        "toolName": {"type": "string", "minLength": 1, "maxLength": 128},
        "operation": {"enum": ["QUERY", "TASK"]},
        "protocol": {"type": "string", "minLength": 1, "maxLength": 64},
        "inputSchemaRef": {"type": "string", "minLength": 1, "maxLength": 512},
        "outputSchemaRef": {"type": "string", "minLength": 1, "maxLength": 512},
        "confirmation": {"enum": ["CONFIRMED", "PENDING"]}
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "role", "sha256", "size"],
      "properties": {
        "path": {"type": "string", "pattern": "^(skill/SKILL\\.md|references/[A-Za-z0-9._/-]+|templates/[A-Za-z0-9._/-]+\\.(md|txt)|cases/[A-Za-z0-9._/-]+\\.json|validation-summary\\.json)$"},
        "role": {"enum": ["SKILL", "REFERENCE", "CASE", "VALIDATION_SUMMARY"]},
        "sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "size": {"type": "integer", "minimum": 0, "maximum": 262144}
      }
    }
  }
}
