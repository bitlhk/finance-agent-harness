{
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "finance-original-calculation-status.v1"
    },
    "runId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "generation": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": [
        "RUNNING",
        "SUCCEEDED",
        "FAILED",
        "CANCELLED",
        "TIMED_OUT"
      ]
    },
    "workerStopped": {
      "type": "boolean"
    },
    "errorCode": {
      "type": [
        "string",
        "null"
      ]
    },
    "snapshotId": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "snapshotDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "inputDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "parameterDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "schemaVersion",
    "runId",
    "generation",
    "status",
    "workerStopped",
    "errorCode"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "source-status.v1.schema.json"
}
