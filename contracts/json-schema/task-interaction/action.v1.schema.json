{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://finance-agent-harness.local/task-interaction/action.v1",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "finance-task-action.v1"
    },
    "taskRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "requestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "expectedVersion": {
      "type": "string",
      "minLength": 1,
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "materialVersion": {
      "type": "string",
      "minLength": 1,
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "action": {
      "type": "string",
      "enum": [
        "claim",
        "supplement",
        "submit",
        "approve",
        "reject",
        "execute",
        "cancel"
      ]
    },
    "parameters": {
      "type": "object",
      "properties": {
        "commissionFee": {
          "type": "number",
          "minimum": 0
        },
        "attachmentRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "executionConfirmed": {
      "type": "boolean"
    }
  },
  "required": [
    "schemaVersion",
    "taskRef",
    "requestId",
    "expectedVersion",
    "materialVersion",
    "action",
    "parameters",
    "executionConfirmed"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "action": {
            "const": "execute"
          }
        }
      },
      "then": {
        "properties": {
          "executionConfirmed": {
            "const": true
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "supplement"
          }
        }
      },
      "then": {
        "properties": {
          "parameters": {
            "type": "object",
            "properties": {
              "commissionFee": {
                "type": "number",
                "minimum": 0
              },
              "attachmentRef": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9_-]+$"
              }
            },
            "required": [],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "reject"
          }
        }
      },
      "then": {
        "properties": {
          "parameters": {
            "type": "object",
            "properties": {
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              }
            },
            "required": [],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "not": {
              "enum": [
                "supplement",
                "reject"
              ]
            }
          }
        }
      },
      "then": {
        "properties": {
          "parameters": {
            "type": "object",
            "properties": {},
            "required": [],
            "additionalProperties": false
          }
        }
      }
    }
  ]
}
