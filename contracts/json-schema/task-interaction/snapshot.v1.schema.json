{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://finance-agent-harness.local/task-interaction/snapshot.v1",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "finance-task-snapshot.v1"
    },
    "taskRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "sourceObjectRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "sourceCommit": {
      "const": "0e158eee225c698774aa75671c944624cd36550b"
    },
    "sourceRelease": {
      "type": "string",
      "minLength": 1,
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "materialVersion": {
      "type": "string",
      "minLength": 1,
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "originalState": {
      "type": "string",
      "enum": [
        "pending",
        "pending_submit",
        "pending_review",
        "approved",
        "executed",
        "rejected",
        "cancelled"
      ]
    },
    "displayState": {
      "type": "string",
      "enum": [
        "WAITING_INPUT",
        "WAITING_REVIEW",
        "WAITING_CONFIRMATION",
        "SUCCEEDED",
        "CANCELLED",
        "REJECTED",
        "UNKNOWN"
      ]
    },
    "allowedActions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "claim",
          "supplement",
          "submit",
          "approve",
          "reject",
          "execute",
          "cancel"
        ]
      }
    },
    "inputRequired": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "attachmentRef",
          "commissionFee"
        ]
      }
    },
    "rawResult": {
      "type": "object"
    },
    "unresolvedRequestIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9_-]+$"
      }
    }
  },
  "required": [
    "schemaVersion",
    "taskRef",
    "sourceObjectRef",
    "sourceCommit",
    "sourceRelease",
    "version",
    "materialVersion",
    "originalState",
    "displayState",
    "allowedActions",
    "inputRequired",
    "rawResult",
    "unresolvedRequestIds"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "unresolvedRequestIds": {
            "minItems": 1
          }
        }
      },
      "then": {
        "properties": {
          "displayState": {
            "const": "UNKNOWN"
          },
          "allowedActions": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "originalState": {
            "const": "pending"
          },
          "unresolvedRequestIds": {
            "maxItems": 0
          }
        }
      },
      "then": {
        "properties": {
          "displayState": {
            "const": "WAITING_INPUT"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "originalState": {
            "const": "pending_submit"
          },
          "unresolvedRequestIds": {
            "maxItems": 0
          }
        }
      },
      "then": {
        "properties": {
          "displayState": {
            "const": "WAITING_INPUT"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "originalState": {
            "const": "pending_review"
          },
          "unresolvedRequestIds": {
            "maxItems": 0
          }
        }
      },
      "then": {
        "properties": {
          "displayState": {
            "const": "WAITING_REVIEW"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "originalState": {
            "const": "approved"
          },
          "unresolvedRequestIds": {
            "maxItems": 0
          }
        }
      },
      "then": {
        "properties": {
          "displayState": {
            "const": "WAITING_CONFIRMATION"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "originalState": {
            "const": "executed"
          },
          "unresolvedRequestIds": {
            "maxItems": 0
          }
        }
      },
      "then": {
        "properties": {
          "displayState": {
            "const": "SUCCEEDED"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "originalState": {
            "const": "rejected"
          },
          "unresolvedRequestIds": {
            "maxItems": 0
          }
        }
      },
      "then": {
        "properties": {
          "displayState": {
            "const": "REJECTED"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "originalState": {
            "const": "cancelled"
          },
          "unresolvedRequestIds": {
            "maxItems": 0
          }
        }
      },
      "then": {
        "properties": {
          "displayState": {
            "const": "CANCELLED"
          }
        }
      }
    }
  ]
}
