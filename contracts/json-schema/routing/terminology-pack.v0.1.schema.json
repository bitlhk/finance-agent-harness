{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bitlhk.github.io/finance-agent-harness/schema/terminology-pack.v0.1.schema.json",
  "title": "Finance Terminology Pack V0.1",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "assetId", "version", "institution", "terms"],
  "properties": {
    "schemaVersion": {"const": "finance-terminology-pack.v0.1"},
    "assetId": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,127}$"},
    "version": {"type": "string", "minLength": 1, "maxLength": 64},
    "institution": {"type": "string", "minLength": 1, "maxLength": 128},
    "terms": {
      "type": "array", "minItems": 1, "maxItems": 256,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["termId", "canonicalTerm", "aliases", "definition", "scope", "supportStatus", "capabilityIds", "sourceRef"],
        "properties": {
          "termId": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,127}$"},
          "canonicalTerm": {"type": "string", "minLength": 1, "maxLength": 80},
          "aliases": {"type": "array", "maxItems": 24, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 80}},
          "definition": {"type": "string", "minLength": 1, "maxLength": 500},
          "scope": {"type": "string", "minLength": 1, "maxLength": 160},
          "supportStatus": {"enum": ["SUPPORTED", "KNOWN_UNSUPPORTED"]},
          "capabilityIds": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9-]*)+$"}},
          "sourceRef": {"type": "string", "minLength": 1, "maxLength": 256}
        },
        "allOf": [
          {"if": {"properties": {"supportStatus": {"const": "SUPPORTED"}}}, "then": {"properties": {"capabilityIds": {"minItems": 1}}}},
          {"if": {"properties": {"supportStatus": {"const": "KNOWN_UNSUPPORTED"}}}, "then": {"properties": {"capabilityIds": {"maxItems": 0}}}}
        ]
      }
    }
  }
}
