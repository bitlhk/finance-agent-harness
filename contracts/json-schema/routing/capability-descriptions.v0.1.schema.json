{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bitlhk.github.io/finance-agent-harness/schema/capability-descriptions.v0.1.schema.json",
  "title": "Finance Capability Descriptions V0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "assetId", "version", "packId", "packVersion", "capabilities"],
  "properties": {
    "schemaVersion": {"const": "finance-capability-descriptions.v0.1"},
    "assetId": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,127}$"},
    "version": {"type": "string", "minLength": 1, "maxLength": 64},
    "packId": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$"},
    "packVersion": {"type": "string", "minLength": 1, "maxLength": 64},
    "capabilities": {
      "type": "array", "minItems": 1, "maxItems": 32,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["capabilityId", "useCases", "exampleUtterances", "negativeExamples"],
        "properties": {
          "capabilityId": {"type": "string", "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9-]*)+$"},
          "useCases": {"$ref": "#/$defs/texts"},
          "outputBoundaries": {"$ref": "#/$defs/texts"},
          "exampleUtterances": {"$ref": "#/$defs/texts"},
          "negativeExamples": {"$ref": "#/$defs/texts"}
        }
      }
    }
  },
  "$defs": {
    "texts": {"type": "array", "minItems": 1, "maxItems": 24, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 240}}
  }
}
