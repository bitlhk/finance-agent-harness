{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bitlhk.github.io/finance-agent-harness/schema/solution-build-input.v1.schema.json",
  "title": "Finance Agent Solution Build Input V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "solutionId",
    "displayName",
    "runtime",
    "profileRef",
    "domainPackRefs",
    "providerRefs",
    "modelRef",
    "evaluationPackRef"
  ],
  "properties": {
    "schemaVersion": {
      "const": "finance-agent-solution-build.v1"
    },
    "solutionId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,63}$"
    },
    "displayName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "runtime": {
      "$ref": "#/$defs/runtimeRef"
    },
    "profileRef": {
      "$ref": "#/$defs/assetRef"
    },
    "domainPackRefs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/assetRef"
      }
    },
    "providerRefs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/assetRef"
      }
    },
    "modelRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "description": "A runtime-resolved model reference. Credentials must not be embedded."
    },
    "evaluationPackRef": {
      "$ref": "#/$defs/assetRef"
    }
  },
  "$defs": {
    "runtimeRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "language", "templateRef", "integrationRef"],
      "properties": {
        "family": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "language": {
          "enum": ["java", "python", "typescript"]
        },
        "templateRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "integrationRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      }
    },
    "assetRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "source"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    }
  }
}
